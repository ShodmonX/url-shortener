ENVIRONMENT=development
APP_DEBUG=false
# Local setup template only. Generate separate random values before starting.
SECRET_KEY=replace-me
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
AUTH_RETURN_REFRESH_TOKEN_IN_BODY=false
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=url_shortener
DATABASE_HOST=db
DATABASE_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=url_shortener
RABBITMQ_PASSWORD=change-me-rabbit-password
RABBITMQ_VHOST=/
FORWARDED_ALLOW_IPS=127.0.0.1
UVICORN_WORKERS=1
